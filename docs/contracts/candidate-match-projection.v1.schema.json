{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://auto-headcount.local/contracts/candidate-match-projection.v1.schema.json",
  "title": "Candidate Match Projection v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "projection_id", "candidate_id", "input_hash", "generator_version", "redaction_version", "generated_at", "source_snapshot_refs", "display_summary", "profile", "redacted_detail", "redaction_report"],
  "properties": {
    "schema_version": { "const": "candidate-match-projection/v1" },
    "projection_id": { "type": "string", "format": "uuid" },
    "candidate_id": { "type": "string", "format": "uuid" },
    "input_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "generator_version": { "type": "string", "minLength": 1, "maxLength": 100 },
    "redaction_version": { "type": "string", "minLength": 1, "maxLength": 100 },
    "generated_at": { "type": "string", "format": "date-time" },
    "source_snapshot_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source_connection_id", "mapping_version", "captured_at"],
        "properties": {
          "source_connection_id": { "type": "string", "format": "uuid" },
          "raw_record_id": { "type": ["string", "null"], "format": "uuid" },
          "contract_version": { "type": ["string", "null"], "maxLength": 100 },
          "mapping_version": { "type": "string", "minLength": 1, "maxLength": 100 },
          "captured_at": { "type": "string", "format": "date-time" }
        }
      }
    },
    "display_summary": { "type": "string", "maxLength": 150 },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["skills", "experience_years", "city", "education", "certificates", "seniority", "industry", "expected_salary", "activity_updated_at"],
      "properties": {
        "skills": { "type": "array", "uniqueItems": true, "maxItems": 100, "items": { "type": "string", "minLength": 1, "maxLength": 100 } },
        "experience_years": { "type": ["integer", "null"], "minimum": 0, "maximum": 80 },
        "city": { "type": ["string", "null"], "maxLength": 100 },
        "education": { "type": ["string", "null"], "enum": [null, "none", "high_school", "associate", "bachelor", "master", "doctorate"] },
        "certificates": { "type": "array", "uniqueItems": true, "maxItems": 50, "items": { "type": "string", "minLength": 1, "maxLength": 150 } },
        "seniority": { "type": ["string", "null"], "maxLength": 100 },
        "industry": { "type": ["string", "null"], "maxLength": 100, "description": "职能方向（ADR-007）：职业标签 title-text 提取的职能方向，未命中回落原始标签" },
        "expected_salary": {
          "type": "object",
          "additionalProperties": false,
          "required": ["minimum", "maximum", "period", "currency"],
          "properties": {
            "minimum": { "type": ["integer", "null"], "minimum": 0 },
            "maximum": { "type": ["integer", "null"], "minimum": 0 },
            "period": { "type": ["string", "null"], "enum": [null, "month", "year", "day", "hour"] },
            "currency": { "type": ["string", "null"], "pattern": "^[A-Z]{3}$" }
          }
        },
        "activity_updated_at": { "type": ["string", "null"], "format": "date-time" }
      }
    },
    "redacted_detail": {
      "type": "object",
      "additionalProperties": false,
      "required": ["career_history", "project_highlights"],
      "properties": {
        "career_history": { "type": "array", "maxItems": 30, "items": { "type": "string", "minLength": 1, "maxLength": 1000 } },
        "project_highlights": { "type": "array", "maxItems": 30, "items": { "type": "string", "minLength": 1, "maxLength": 1000 } }
      }
    },
    "redaction_report": {
      "type": "object",
      "additionalProperties": false,
      "required": ["removed_categories", "generalized_categories", "residual_pii_scan"],
      "properties": {
        "removed_categories": { "type": "array", "uniqueItems": true, "items": { "type": "string", "enum": ["name", "avatar", "birth_date", "id_number", "phone", "email", "social_account", "personal_url", "detailed_address", "portal_token", "supplier_candidate_id", "owner_name", "sensitive_personal_attribute"] } },
        "generalized_categories": { "type": "array", "uniqueItems": true, "items": { "type": "string", "enum": ["company_name", "project_name", "client_name", "location"] } },
        "residual_pii_scan": { "const": "passed" }
      }
    }
  }
}
