{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://auto-headcount.local/contracts/liebide-candidate-detail.receipt.v1.schema.json",
  "title": "Liebide Candidate Detail Extraction Receipt v1",
  "description": "CSDN-Agent 返回给 auto-headcount 的候选人画像白名单回执。含真实姓名（候选人画像属敏感业务，只经本回执进入内部 candidates，RBAC + 加密 + 审计，不落日志/审计/任务载荷）；匹配 LLM 投影由 Consumer 侧脱敏生成。不含联系方式、简历正文。未知字段和敏感键由 Consumer 失败关闭。",
  "type": "object",
  "additionalProperties": false,
  "required": ["contractId", "contractVersion", "status", "source", "record", "contentHash"],
  "properties": {
    "contractId": {
      "const": "liebide-candidate-detail-v1"
    },
    "contractVersion": {
      "const": 1
    },
    "status": {
      "const": "extracted"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["origin", "capturedAt"],
      "properties": {
        "origin": {
          "const": "https://portal.liebide.com"
        },
        "capturedAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidateId",
        "realName",
        "title",
        "company",
        "yearOfExperience",
        "cityName",
        "school",
        "major",
        "degree",
        "completion",
        "recommendationCount",
        "workExperiences"
      ],
      "properties": {
        "candidateId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "pattern": "^[A-Za-z0-9._:@/-]+$"
        },
        "realName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200000
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200000
        },
        "company": {
          "type": "string",
          "maxLength": 200000
        },
        "yearOfExperience": {
          "type": ["integer", "null"],
          "minimum": 0
        },
        "cityName": {
          "type": "string",
          "maxLength": 200000
        },
        "school": {
          "type": "string",
          "maxLength": 200000
        },
        "major": {
          "type": "string",
          "maxLength": 200000
        },
        "degree": {
          "type": "string",
          "maxLength": 200000
        },
        "completion": {
          "type": ["integer", "null"],
          "minimum": 0,
          "maximum": 100
        },
        "recommendationCount": {
          "type": ["integer", "null"],
          "minimum": 0
        },
        "workExperiences": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["company", "title"],
            "properties": {
              "company": {
                "type": "string",
                "maxLength": 200000
              },
              "title": {
                "type": "string",
                "maxLength": 200000
              }
            }
          }
        }
      }
    },
    "contentHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}