{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://auto-headcount.local/contracts/liebide-job-detail.receipt.v1.schema.json",
  "title": "Liebide Job Detail Extraction Receipt v1",
  "description": "CSDN-Agent 返回给 auto-headcount 的职位详情白名单回执。未知字段和敏感键由 Consumer 失败关闭。",
  "type": "object",
  "additionalProperties": false,
  "required": ["contractId", "contractVersion", "status", "source", "record", "contentHash"],
  "properties": {
    "contractId": {
      "const": "liebide-job-detail-v1"
    },
    "contractVersion": {
      "const": 1
    },
    "status": {
      "const": "extracted"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["origin", "capturedAt"],
      "properties": {
        "origin": {
          "const": "https://portal.liebide.com"
        },
        "capturedAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "externalId",
        "title",
        "status",
        "city",
        "salaryMin",
        "salaryMax",
        "jobDescription",
        "publishedAt",
        "validRecommendationCount"
      ],
      "properties": {
        "externalId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "pattern": "^[A-Za-z0-9._:@/-]+$"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200000
        },
        "status": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200000
        },
        "city": {
          "type": "string",
          "maxLength": 200000
        },
        "salaryMin": {
          "type": ["integer", "null"],
          "minimum": 0
        },
        "salaryMax": {
          "type": ["integer", "null"],
          "minimum": 0
        },
        "jobDescription": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200000
        },
        "publishedAt": {
          "type": ["string", "null"],
          "format": "date-time"
        },
        "validRecommendationCount": {
          "type": ["integer", "null"],
          "minimum": 0
        }
      }
    },
    "contentHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
