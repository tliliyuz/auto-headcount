# MCP server (never commit real credentials)
MCP_SERVER_URL=https://kunpeng.csdn.net/mcp
MCP_ACCESS_KEY=replace_with_rotated_access_key
MCP_SECRET_KEY=replace_with_rotated_secret_key
MCP_TIMEOUT_MS=60000

# Application
APP_BASE_URL=http://localhost:3000
APP_ENCRYPTION_KEY=replace_with_base64_encoded_32_byte_key
APP_ENCRYPTION_KEY_VERSION=local-v1
DATABASE_URL=postgresql://auto_headcount:replace_with_local_dev_password@localhost:5432/auto_headcount
APP_PORT=3000

# Local PostgreSQL container (development only)
POSTGRES_DB=auto_headcount
POSTGRES_USER=auto_headcount
POSTGRES_PASSWORD=replace_with_local_dev_password
POSTGRES_PORT=5432

# Optional integrations, configured only when enabled
LLM_PROVIDER=
LLM_API_KEY=
SMS_PROVIDER=
SMS_API_KEY=
EMAIL_PROVIDER=
EMAIL_API_KEY=
