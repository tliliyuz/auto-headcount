# 生产环境变量模板（云服务器 docker compose，docker-compose.prod.yml 经 env_file 注入）。
# 复制为 `.env.production` 并填写；`.env.production` 已被 `.gitignore` 排除，不得提交真实凭证。
# 部署步骤见 README「部署（云服务器）」与 docker-compose.prod.yml 顶部注释。

# 生产 PostgreSQL（compose 内 db 服务；扩容为托管 PG 时改 DATABASE_URL 指向外部实例）
POSTGRES_DB=auto_headcount
POSTGRES_USER=auto_headcount
POSTGRES_PASSWORD=replace_with_strong_production_password
DATABASE_URL=postgresql://auto_headcount:replace_with_strong_production_password@db:5432/auto_headcount

# 运行时环境（必须 production：关闭时生产管理员 TOTP 强制与 Secure Cookie 会静默失效并告警）
APP_ENV=production

# 应用加密密钥（生产专用，用 `openssl rand -base64 32` 生成，不要复用开发/测试密钥）
APP_ENCRYPTION_KEY=replace_with_base64_encoded_32_byte_key
APP_ENCRYPTION_KEY_VERSION=prod-v1

# MCP 凭证（真实轮换值，不得使用开发/测试凭证）
MCP_SERVER_URL=https://kunpeng.csdn.net/mcp
MCP_ACCESS_KEY=replace_with_rotated_access_key
MCP_SECRET_KEY=replace_with_rotated_secret_key
MCP_TIMEOUT_MS=60000

# 同步 tick / 数据源（非密钥；scheduler 服务读入队周期与来源身份）
SYNC_SOURCE_PROVIDER=csdn-mcp
SYNC_SOURCE_DISPLAY_NAME=CSDN Enterprise MCP
SYNC_INTERVAL_HOURS=6

# 生产首管理员初始化（一次性口令，init-admin.mjs 使用，仅生产环境）
# ADMIN_INIT_PASSWORD=replace_with_one_time_password
