{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://auto-headcount.local/contracts/liebide-talent-pool-list.request.v1.schema.json",
  "title": "Liebide Talent Pool List Extraction Request v1",
  "description": "auto-headcount 发送给 CSDN-Agent 受限提取工具的固定参数。browserSessionId 仅用于交互式显式路由，持久化任务省略并由 userId + deviceId 限定 active page。生产任务不得增加脚本、选择器、URL、Cookie 或页面正文。",
  "type": "object",
  "additionalProperties": false,
  "required": ["userId", "deviceId", "contractId", "batchSize", "maxPages"],
  "properties": {
    "userId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^[A-Za-z0-9._:@/-]+$"
    },
    "deviceId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^[A-Za-z0-9._:@/-]+$"
    },
    "browserSessionId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^[A-Za-z0-9._:@/-]+$"
    },
    "contractId": {
      "const": "liebide-talent-pool-list-v1"
    },
    "batchSize": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100
    },
    "maxPages": {
      "type": "integer",
      "minimum": 1,
      "maximum": 20
    },
    "startPage": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10000
    },
    "startOffset": {
      "type": "integer",
      "minimum": 0,
      "maximum": 10000
    }
  }
}
