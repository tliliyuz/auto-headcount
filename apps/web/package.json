{
  "name": "site-creator-vinext-starter",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "build": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test": "npm run test:unit && npm run build && node --test tests/rendered-html.test.mjs",
    "test:unit": "node --test tests/job-rules.test.mjs tests/mcp-discovery.test.mjs tests/mcp-tool-call.test.mjs tests/mcp-under-served-contract.test.mjs tests/match-candidates-fixture.test.mjs tests/payload-encryption.test.mjs tests/postgres-migration-contract.test.mjs",
    "test:integration": "node --test tests/postgres-integration.test.mjs tests/postgres-job-sync.integration.test.mjs tests/under-served-sync.integration.test.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node db/migrate.mjs",
    "mcp:discover": "node --env-file-if-exists=../../.env.local --env-file-if-exists=.env.local scripts/discover-mcp.mjs",
    "mcp:sample-jobs": "node --env-file-if-exists=../../.env.local --env-file-if-exists=.env.local scripts/sample-under-served-jobs.mjs",
    "mcp:sample-candidates": "node --env-file-if-exists=../../.env.local --env-file-if-exists=.env.local scripts/sample-candidates.mjs",
    "sync:under-served": "node --env-file-if-exists=../../.env.local --env-file-if-exists=.env.local scripts/run-under-served-sync.mjs"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "postgres": "^3.4.9",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@eslint/js": "9.39.4",
    "@next/eslint-plugin-next": "16.2.6",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.4.0",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.3",
    "vinext": "1.0.0-beta.2",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
