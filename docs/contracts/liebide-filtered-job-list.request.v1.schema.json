{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://auto-headcount.local/contracts/liebide-filtered-job-list.request.v1.schema.json",
  "title": "Liebide filtered job list extraction request v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["userId", "deviceId", "contractId", "batchSize", "maxPages"],
  "properties": {
    "userId": { "type": "string", "minLength": 1, "maxLength": 200 },
    "deviceId": { "type": "string", "minLength": 1, "maxLength": 200 },
    "browserSessionId": { "type": "string", "minLength": 1, "maxLength": 200 },
    "contractId": { "const": "liebide-filtered-job-list-v1" },
    "batchSize": { "type": "integer", "minimum": 1, "maximum": 100 },
    "maxPages": { "type": "integer", "minimum": 1, "maximum": 20 },
    "startPage": { "type": "integer", "minimum": 1, "maximum": 10000 },
    "startOffset": { "type": "integer", "minimum": 0, "maximum": 10000 }
  }
}
