{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/web-lint-report.sh"
          }
        ]
      }
    ]
  },
  "permissions": {
    "ask": [
      "Bash(npm --prefix apps/web exec eslint --fix*)",
      "Bash(npx eslint --fix*)"
    ]
  }
}
