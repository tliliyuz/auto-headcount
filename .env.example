# MCP server (never commit real credentials)
MCP_SERVER_URL=https://kunpeng.csdn.net/mcp
MCP_ACCESS_KEY=replace_with_rotated_access_key
MCP_SECRET_KEY=replace_with_rotated_secret_key
MCP_TIMEOUT_MS=60000

# Application
APP_BASE_URL=http://localhost:3000
APP_ENCRYPTION_KEY=replace_with_base64_encoded_32_byte_key
APP_ENCRYPTION_KEY_VERSION=local-v1
DATABASE_URL=postgresql://auto_headcount:replace_with_local_dev_password@localhost:5432/auto_headcount
APP_PORT=3000

# Local PostgreSQL container (development only)
POSTGRES_DB=auto_headcount
POSTGRES_USER=auto_headcount
POSTGRES_PASSWORD=replace_with_local_dev_password
POSTGRES_PORT=5432

# Development-only fixture login (seed-dev-users.mjs)
# 可选覆盖项：留空/注释时种子脚本使用默认 dev 口令 ops/OpsPass2026!、admin/AdminPass2026!。
# 注意：不要填成占位符——以 replace_with_ 开头的值会被种子脚本视为未设置。
# DEV_SEED_OPS_PASSWORD=
# DEV_SEED_ADMIN_PASSWORD=

# Production first admin bootstrap (init-admin.mjs, production only)
# ADMIN_INIT_PASSWORD=replace_with_one_time_password

# Retention cleanup TTL days (run-retention.mjs)
RETENTION_RAW_SUCCESS_DAYS=30
RETENTION_RAW_EXCEPTION_DAYS=90
RETENTION_JOB_CLOSED_DAYS=180
RETENTION_AUDIT_DAYS=365

# Scheduled sync (async_tasks task-table scheduler, Worker env bindings)
# 非密钥来源配置；加密/ MCP 凭证为 Worker env 绑定（部署时配置，不写入 dev）。
SYNC_SOURCE_PROVIDER=csdn-mcp
SYNC_SOURCE_DISPLAY_NAME=CSDN Enterprise MCP
SYNC_INTERVAL_HOURS=6

# Optional integrations, configured only when enabled
LLM_PROVIDER=
LLM_API_KEY=
SMS_PROVIDER=
SMS_API_KEY=
EMAIL_PROVIDER=
EMAIL_API_KEY=
