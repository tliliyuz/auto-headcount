{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://auto-headcount.local/contracts/liebide-job-detail.request.v2.schema.json",
  "title": "Liebide Job Detail Extraction Request v2",
  "description": "auto-headcount 发送给 CSDN-Agent 受限提取工具的固定参数（v2 与 v1 同参，仅契约 ID 升级为 liebide-job-detail-v2）。browserSessionId 仅用于交互式显式路由，持久化任务省略并由 userId + deviceId 限定 active page。生产任务不得增加脚本、选择器、URL、Cookie 或页面正文。",
  "type": "object",
  "additionalProperties": false,
  "required": ["userId", "deviceId", "contractId", "expectedExternalId"],
  "properties": {
    "userId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^[A-Za-z0-9._:@/-]+$"
    },
    "deviceId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^[A-Za-z0-9._:@/-]+$"
    },
    "browserSessionId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^[A-Za-z0-9._:@/-]+$"
    },
    "contractId": {
      "const": "liebide-job-detail-v2"
    },
    "expectedExternalId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^[A-Za-z0-9._:@/-]+$"
    },
    "expectedTitle": {
      "description": "发现阶段列表卡片上的职位标题，用于详情合同校验当前渲染内容确为目标岗位，防止同文档 hash 导航残留上一个岗位的 DOM。",
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    }
  }
}
